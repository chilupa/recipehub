# Copy to .env and fill in values from Firebase Console / native config.
# Never commit a filled-in .env.

# Firebase (Auth + Firestore + Storage) — see FIREBASE_SETUP.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Sign-In (from google-services.json oauth_client entries)
# Web client (client_type 3) from google-services.json
VITE_GOOGLE_WEB_CLIENT_ID=
# iOS client from GoogleService-Info.plist CLIENT_ID
VITE_GOOGLE_IOS_CLIENT_ID=

# Sharing links (optional)
VITE_SHARE_WEB_BASE_URL=
VITE_APP_DOWNLOAD_URL=

# Dev flags
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_DATA=false
VITE_SHOW_SIGNIN_STATUS_BANNER=false
